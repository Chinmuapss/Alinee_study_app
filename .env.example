# Copy to .env and replace with values from Supabase Project Settings > API.
# The anon key is safe for client use only when the SQL RLS policies are enabled.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Optional. Used only to construct map links; no API key is required.
MAPS_URL_TEMPLATE=https://www.openstreetmap.org/?mlat={lat}&mlon={lng}#map=18/{lat}/{lng}
